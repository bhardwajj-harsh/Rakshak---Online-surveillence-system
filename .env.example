# Database
DATABASE_URL=sqlite:///./rakshak.db

# ML Models
MODEL_PATH=./ml/models

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000

# WebSocket
WS_URL=ws://localhost:8000/ws/live

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/live

# Demo Mode
DEMO_MODE=true

# Frame Processing
FRAME_SKIP=3

# Hardware cameras (macOS: 0 = MacBook, 1 = iPhone Continuity)
ENABLE_HARDWARE_CAMERA=true
CAMERA_0_DEVICE_INDEX=0
CAMERA_1_DEVICE_INDEX=1

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
